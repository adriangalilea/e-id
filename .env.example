# Application URL (optional - auto-detected)
# Development: defaults to http://localhost:3000
# Production: defaults to https://e-id.to
# Only set this if you need to override the default behavior
# BETTER_AUTH_URL=http://localhost:3000

# Better Auth Secret (required)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your_auth_secret_here

# Auth Providers
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GITHUB_CLIENT_ID=your_github_oauth_app_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_secret

# GitHub API Token (Classic)
# Create a classic token at: https://github.com/settings/tokens
# Required scope: read:user
API_GITHUB_TOKEN=your_github_token_here

# Database (libsql/Turso)
# Get these from your Turso dashboard: https://turso.tech/
DB_URL=your_database_url_here
DB_AUTH_TOKEN=your_database_auth_token_here

# Google Safe Browsing (required to save a website or a link of your own): a
# Google Cloud API key with the Safe Browsing API enabled, restricted to it.
# Non-commercial terms: move to Web Risk before taking money (README, billing).
SAFE_BROWSING_KEY=your_safe_browsing_key_here

# The daily re-check of every link's destination (app/api/cron/recheck): Vercel's
# cron sends it as a bearer token. Generate with: openssl rand -hex 32
CRON_SECRET=your_cron_secret_here

# Visits (optional, off when unset): the Turso database holding the visits_*
# tables, and a token that can read, add, update and delete them.
# VISITS_DATABASE_URL=
# VISITS_AUTH_TOKEN=
